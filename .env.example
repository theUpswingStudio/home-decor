# Local development through raine/claude-code-proxy.
AI_PROVIDER=local-proxy
CCP_OPENAI_BASE_URL=http://127.0.0.1:18765/v1
CCP_MODEL=gpt-5.6-terra
AI_SESSION_SECRET=replace-with-a-long-random-local-value

# Image previews always use OpenRouter, independent of AI_PROVIDER.
OPENROUTER_API_KEY=
OPENROUTER_IMAGE_MODEL=openai/gpt-image-2

# Use this only for deterministic UI development without a running model.
# AI_PROVIDER=mock

# Use OpenRouter for text analysis and chat too.
# AI_PROVIDER=openrouter
# OPENROUTER_MODEL=openai/gpt-5.6-terra
# APP_ORIGIN=https://example.com
